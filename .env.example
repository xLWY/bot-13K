# Copy this file to .env and replace placeholder values.
#   -> On Windows:  copy .env.example .env
#   -> On Linux:    cp .env.example .env
# NEVER commit your .env (it is ignored by .gitignore).

# ── Discord Bot Configuration ──────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
# TOKEN=your_discord_bot_token_here          # optional alias for DISCORD_TOKEN
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here
OWNER_IDS=your_discord_id_here               # comma-separated
# BOT_OWNER_IDS=                             # optional alias for OWNER_IDS

# ── Bot Runtime Configuration ──────────────────────────────────────────────
NODE_ENV=production                          # production | development | test
LOG_LEVEL=warn                               # error | warn | info | http | verbose | debug | silly
LOG_TO_FILE=false
SENTRY_DSN=                                  # optional error tracking

# ── Web/API Configuration ──────────────────────────────────────────────────
PORT=3000
WEB_HOST=0.0.0.0
PORT_RETRY_ATTEMPTS=5
CORS_ORIGIN=*

# ── PostgreSQL Configuration ───────────────────────────────────────────────
# You can either provide a full connection URL (first line) or individual
# POSTGRES_HOST/PORT/DB/USER/PASSWORD. The bot also understands DATABASE_URL
# (Railway's default Postgres variable) and PGURL.
DATABASE_URL=
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/lwbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lwbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_SSL=false                            # set true on managed hosts (Railway, Neon...)

# ── PostgreSQL Pool/Timeout Settings ───────────────────────────────────────
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_CONNECTION_TIMEOUT=10000
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_RETRIES=3
POSTGRES_BACKOFF_BASE=100
POSTGRES_BACKOFF_MULTIPLIER=2

# ── Migration & Schema Settings ────────────────────────────────────────────
AUTO_MIGRATE=true
POSTGRES_MIGRATION_TABLE=schema_migrations
SCHEMA_VERSION=1
SCHEMA_VERSION_LABEL=baseline-v1

# ── Backup/Restore Script Settings ─────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
POSTGRES_RESTORE_URL=

# ── Misc / advanced ────────────────────────────────────────────────────────
TEST_GUILD_ID=                                # optional: guild used for tests
# COMMIT_SHA=                                 # set automatically by CI (used in /version)